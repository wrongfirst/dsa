      "property": "invertTree",
      "input": {
        "root": [
          3,
          2,
          1
        ]
      },
      "expected": [
        3,
        1,
        2
      ]
    },
    {
      "uuid": "01777046-002a-4c97-af1f-b055770159df",
      "description": "Problem Example 3",
      "property": "invertTree",
      "input": {
        "root": []
      },
      "expected": []
    },
    {
      "uuid": "dd971a68-aba5-4149-9c54-a2b9aad1a3f2",
