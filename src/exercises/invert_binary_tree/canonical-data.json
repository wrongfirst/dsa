          2,
          null,
          3
        ]
      },
      "expected": [
        1,
        2,
        null,
        3
      ]
    },
    {
      "uuid": "78c2eee7-217b-4289-b9d8-872a13b90bb2",
      "description": "Negative values and bounds",
      "property": "invertTree",
      "input": {
        "root": [
